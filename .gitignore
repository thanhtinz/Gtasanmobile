# --- prebuilt native libraries -----------------------------------------------
# Fetched by tools/fetch-prebuilt.sh, never committed. libGame.so in particular
# is Rockstar's GTA:SA engine and does not belong in this repository.
client/android/app/src/main/jniLibs/

# --- Firebase ----------------------------------------------------------------
# The build no longer needs this; the guard stops the upstream author's config
# (which carries their live API key) from being committed by accident.
google-services.json

